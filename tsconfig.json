{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "paths": { "@review/*": ["./supabase/functions/_shared/review/*"] }
  },
  "include": ["src", "e2e", "supabase/functions/_shared/review", "supabase/functions/_shared/skill.generated.ts", "supabase/functions/_shared/skill.test.ts", "scripts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
