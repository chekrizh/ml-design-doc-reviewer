# Copy to .env.local for `pnpm dev`. Values below point to local Supabase (`supabase start`).
# The publishable key is the CLI's local default (see `supabase status`); in production use the
# project's publishable key. No secrets here: the Google Client Secret lives only in Supabase.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# OAuth Client ID (Web) for Drive export; empty locally (e2e stubs Google).
VITE_GOOGLE_CLIENT_ID=
# Shows "Sign in as test user". true only locally and in e2e; never set in production.
VITE_TEST_SIGNIN=true
